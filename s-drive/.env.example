# S-Drive — copier en .env et remplir (ne jamais publier .env)
POSTGRES_PASSWORD=change-moi
# Compte administrateur créé au PREMIER démarrage (min. 12 caractères)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_DISPLAY_NAME=Administrateur
ADMIN_PASSWORD=Styve@237
# Création de compte par les utilisateurs (lien « S'inscrire »)
REGISTRATION_ENABLED=true
PASSWORD_MIN_LENGTH=12
# Sessions : sans « Se souvenir de moi » (heures) / avec (jours)
SESSION_HOURS=12
REMEMBER_DAYS=30
# Adresse d'écoute
WEB_BIND=0.0.0.0
WEB_PORT=8090
