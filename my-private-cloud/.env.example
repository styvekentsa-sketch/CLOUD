# =============================================================================
#  my-private-cloud — variables d'environnement
#  Générer .env avec :  .\scripts\init-env.ps1 -Mode local      (Windows)
#                       ./scripts/init-env.sh local              (Linux/macOS)
#  NE JAMAIS COMMITER .env ! (contient les mots de passe)
# =============================================================================

# --- Mode : "local" (PC, HTTP) ou "vps" (serveur, HTTPS) --------------------
CLOUD_MODE=local
TZ=Europe/Paris
DEFAULT_PHONE_REGION=FR

# --- Adresses ---------------------------------------------------------------
# URL principale du cloud (liens générés, tâches cron)
#   local : http://<IP-LAN>:8080        vps : https://cloud.mondomaine.fr
NEXTCLOUD_URL=http://localhost:8080
# Noms/IP autorisés, séparés par des espaces (resynchronisés à chaque démarrage)
#   local : localhost 127.0.0.1 <IP-LAN> <nom-du-PC>
#   vps   : cloud.mondomaine.fr
NEXTCLOUD_TRUSTED_DOMAINS=localhost 127.0.0.1
# true = accepte aussi TOUTE adresse IP privée du réseau local (wildcards
# 192.168.*, 10.*, 172.16-31.*, *.local, *.lan) -> survit au changement d'IP.
#   local : true        vps : false
NEXTCLOUD_TRUSTED_LAN=true
# Domaine public (utilisé en mode VPS)
NEXTCLOUD_DOMAIN=cloud.example.com

# --- HTTPS / reverse proxy ----------------------------------------------------
#   local : vides (HTTP accepté, pas de redirection forcée)
#   vps   : OVERWRITE_PROTOCOL=https  et  OVERWRITE_HOST=cloud.mondomaine.fr
OVERWRITE_PROTOCOL=
OVERWRITE_HOST=
# Sous-réseau Docker du proxy (NPM / cloudflared) — doivent être identiques
FRONTEND_SUBNET=172.30.0.0/24
TRUSTED_PROXIES=172.30.0.0/24

# --- Exposition du port --------------------------------------------------------
#   local : 0.0.0.0   -> http://localhost:8080 + http://<IP-LAN>:8080
#   vps   : 127.0.0.1 -> seul le proxy est accessible depuis Internet
APP_BIND=0.0.0.0
APP_PORT=8080
# Interface d'admin Nginx Proxy Manager (port 81) — garder 127.0.0.1
NPM_ADMIN_BIND=127.0.0.1

# --- Stockage des fichiers (dossier du disque dur, sans limite de quota) --------
#   Relatif : ./cloud_data   |   Windows : D:/NextcloudData   |   Linux : /srv/cloud_data
NEXTCLOUD_DATA_DIR=./cloud_data

# --- Compte administrateur Nextcloud (créé au premier démarrage) ------------
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=CHANGE_ME

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud
POSTGRES_PASSWORD=CHANGE_ME
# Dimensionnement selon la RAM disponible pour Docker :
#   RAM Docker      shared_buffers  effective_cache  work_mem  maintenance  shm
#   2 Go (VPS)      256MB           768MB            8MB       64MB         256mb
#   4 Go (VPS)      512MB           1536MB           16MB      128MB        512mb
#   8 Go (PC 16 Go) 1GB             3GB              32MB      256MB        1gb
#   16 Go           2GB             6GB              64MB      512MB        2gb
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE_SIZE=3GB
PG_WORK_MEM=32MB
PG_MAINTENANCE_WORK_MEM=256MB
PG_SHM_SIZE=1gb
PG_MAX_WORKERS=4

# --- Redis (cache + verrouillage de fichiers) ---------------------------------
REDIS_PASSWORD=CHANGE_ME
REDIS_MAXMEMORY=512mb

# --- PHP : gros fichiers --------------------------------------------------------
# memory_limit = 2147483648 octets (2 Go)
PHP_MEMORY_LIMIT=2147483648
# upload_max_filesize = post_max_size = 16G
PHP_UPLOAD_LIMIT=16G
# 0 = pas de limite de taille de requête côté Apache
APACHE_BODY_LIMIT=0

# --- Sauvegardes d'applications (WhatsApp…) : purge des copies datées ---------
# Dossiers Nextcloud (relatifs aux fichiers de chaque utilisateur, séparés par ";")
# où supprimer les fichiers nommés avec une date (msgstore-AAAA-MM-JJ.1.db.crypt14)
APP_BACKUP_CLEANUP_DIRS=Sauvegardes/WhatsApp/Databases
APP_BACKUP_RETENTION_DAYS=14
# true = liste ce qui serait supprimé sans rien effacer
APP_BACKUP_DRY_RUN=false

# --- Comptes, groupes & sécurité (appliqués par scripts/optimize.ps1) -----------
# Groupes créés automatiquement (noms sans espace)
USER_GROUPS=Entreprises Clients Equipe
# false = aucun lien de partage public (aucun accès anonyme) ; true = autorisés
# (toujours avec mot de passe + expiration 14 jours)
SECURITY_ALLOW_PUBLIC_LINKS=false
# Groupes pour lesquels la 2FA est OBLIGATOIRE : liste | all | none
SECURITY_2FA_ENFORCED_GROUPS=admin Entreprises Equipe
PASSWORD_MIN_LENGTH=12
# Quota par défaut des nouveaux comptes : none (illimité) ou "50 GB", "1 TB"…
DEFAULT_QUOTA=none

# --- E-mail : serveur SMTP Gmail (README §10) -----------------------------------
# Adresse du compte administrateur + destinataire de toutes les alertes
ADMIN_EMAIL=admin@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# tls = STARTTLS sur le port 587 (Gmail) ; ssl = port 465
SMTP_SECURE=tls
SMTP_AUTHTYPE=LOGIN
# Compte Gmail qui envoie
SMTP_NAME=admin@example.com
# >>> MOT DE PASSE D'APPLICATION Gmail : 16 lettres, SANS espaces, sans guillemets
# >>> (https://myaccount.google.com/apppasswords) — jamais le mot de passe Google
SMTP_PASSWORD=
# Expéditeur = MAIL_FROM_ADDRESS@MAIL_DOMAIN (doit être l'adresse Gmail ci-dessus)
MAIL_FROM_ADDRESS=admin
MAIL_DOMAIN=example.com

# --- Alertes de sécurité par e-mail (toutes les 5 min, regroupées) -------------
# Destinataire (vide = ADMIN_EMAIL)
ALERT_EMAIL=
# Connexion réussie depuis un nouvel appareil / une nouvelle IP
ALERT_NEW_LOGIN=true
# Échecs de connexion : alerte à partir de N échecs en ALERT_FAILED_LOGIN_WINDOW s
ALERT_FAILED_LOGIN_THRESHOLD=5
ALERT_FAILED_LOGIN_WINDOW=900
# Création/suppression de comptes, groupes, rôles (admin, sous-admin)
ALERT_ACCOUNT_CHANGES=true
# Disque ou quota utilisé au-delà de ce pourcentage (alerte 1x/jour)
ALERT_STORAGE_PERCENT=90

# --- Tableau de bord système (profil "monitoring" : Glances) -------------------
MONITORING_BIND=127.0.0.1
MONITORING_PORT=61208

# --- [VPS] Cloudflare Tunnel (profil "cloudflare") ------------------------------
CLOUDFLARE_TUNNEL_TOKEN=

# --- Versions des images (épinglées : mêmes versions en local et sur le VPS) --
NEXTCLOUD_IMAGE_TAG=32-apache
POSTGRES_IMAGE_TAG=17-alpine
REDIS_IMAGE_TAG=7-alpine
ALPINE_IMAGE_TAG=3.20
NPM_IMAGE_TAG=2
CLOUDFLARED_IMAGE_TAG=latest

# --- Identité visuelle (nom, slogan, couleur principale) ----------------------
BRAND_NAME=S-Drive
BRAND_SLOGAN=Votre cloud privé et sécurisé
BRAND_COLOR=#0B5563
BRAND_BACKGROUND=#0A3F48
